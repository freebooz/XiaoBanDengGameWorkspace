# 小板凳游戏平台本地开发环境变量
HTTP_ADDR=:8080
POSTGRES_URL=postgres://xbd:xbd_dev_password@postgres:5432/xbd?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 只读管理员：必须自行生成 bcrypt 哈希，未配置时管理接口拒绝访问。
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# 仅本地 HTTP 联调用 false；正式 HTTPS 必须 true。
ADMIN_COOKIE_SECURE=false
# 优先使用同源代理；跨域时填写精确来源，逗号分隔，禁止通配符。
ADMIN_ALLOWED_ORIGINS=
# 仅填写直接代理的精确 IP/CIDR；本地 Vite 可填 127.0.0.1/32，禁止 0.0.0.0/0。
ADMIN_TRUSTED_PROXY_CIDRS=
# 正式服务拒绝不存在的象棋房间；开启时数据显式标记 development。
DEVELOPMENT_ROOMS=false

# 微信登录：仅占位，严禁提交真实密钥
WECHAT_APP_ID=replace_me
WECHAT_APP_SECRET=replace_me

# 微信支付：仅占位
WECHAT_MCH_ID=replace_me
WECHAT_API_V3_KEY=replace_me
WECHAT_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
