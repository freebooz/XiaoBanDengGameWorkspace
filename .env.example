# 小板凳游戏平台本地开发环境变量
HTTP_ADDR=:8080
POSTGRES_URL=postgres://xbd:xbd_dev_password@postgres:5432/xbd?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 微信登录：仅占位，严禁提交真实密钥
WECHAT_APP_ID=replace_me
WECHAT_APP_SECRET=replace_me

# 微信支付：仅占位
WECHAT_MCH_ID=replace_me
WECHAT_API_V3_KEY=replace_me
WECHAT_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem