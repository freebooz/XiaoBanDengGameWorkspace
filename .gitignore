# 小板凳游戏平台：通用忽略规则
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db

# Go
server/bin/
server/coverage.out

# Node
admin-web/node_modules/
admin-web/dist/

# Godot
.godot/
client/.generated/

# 日志与运行数据
logs/
*.log
data/

# 本机验证、工具下载与可重建产物；正式编辑源仍保留在 SourceAssets 和 mahjong_models。
/.tmp/
/.superpowers/
/artifacts/toolcache/
/artifacts/screenshots/
**/target/
*.blend1
*.blend@

# 签名私钥和本机证书容器不得随代码提交。
*.keystore
*.jks
*.p12
*.pfx
*.key

# Versioned Mahjong client export directories.
/artifacts/mahjong-[0-9]*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
